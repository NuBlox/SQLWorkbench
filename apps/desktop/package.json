{
  "name": "@nublox/sql-workbench-desktop",
  "version": "0.2.0-rc.1",
  "description": "NuBlox SQL Workbench desktop database engineering environment",
  "author": {
    "name": "NuBlox",
    "email": "56647740+NuBlox@users.noreply.github.com"
  },
  "desktopName": "com.nublox.sqlworkbench",
  "private": true,
  "type": "module",
  "main": "./dist/electron/main/main.js",
  "scripts": {
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "start": "pnpm build && electron .",
    "start:built": "electron .",
    "test": "node --test test/*.test.mjs",
    "package": "pnpm build && electron-builder --publish never",
    "package:built": "electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package:dir:built": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "@nublox/workbench-catalog": "workspace:*",
    "@nublox/workbench-connection-profiles": "workspace:*",
    "@nublox/workbench-core": "workspace:*",
    "@nublox/workbench-provider-api": "workspace:*",
    "@nublox/workbench-provider-mysql": "workspace:*",
    "@nublox/workbench-query-engineering": "workspace:*",
    "@nublox/workbench-schema-engineering": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^22.18.6",
    "electron": "44.4.5",
    "electron-builder": "26.17.0",
    "monaco-editor": "0.57.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "^5.8.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "com.nublox.sqlworkbench",
    "productName": "NuBlox SQL Workbench",
    "executableName": "nublox-sql-workbench",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/renderer/**/*",
      "dist/electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "category": "Development",
      "target": ["AppImage", "deb", "tar.gz"],
      "syncDesktopName": true,
      "maintainer": "NuBlox <56647740+NuBlox@users.noreply.github.com>",
      "vendor": "NuBlox",
      "synopsis": "NuBlox SQL Workbench"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
