{
  "name": "@nublox/sql-workbench-desktop",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "NuBlox SQL Workbench desktop database engineering environment",
  "author": "NuBlox",
  "type": "module",
  "main": "./dist/electron/main/main.js",
  "scripts": {
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "start": "pnpm build && electron .",
    "start:built": "electron .",
    "test": "node --test test/*.test.mjs",
    "package:dir": "pnpm build && pnpm dlx electron-builder@26.15.3 --dir --publish never",
    "package:mac": "pnpm build && pnpm dlx electron-builder@26.15.3 --mac zip --publish never",
    "package:linux": "pnpm build && pnpm dlx electron-builder@26.15.3 --linux AppImage --publish never",
    "package:win": "pnpm build && pnpm dlx electron-builder@26.15.3 --win portable --publish never"
  },
  "dependencies": {
    "@nublox/workbench-catalog": "workspace:*",
    "@nublox/workbench-connection-profiles": "workspace:*",
    "@nublox/workbench-core": "workspace:*",
    "@nublox/workbench-provider-api": "workspace:*",
    "@nublox/workbench-provider-mysql": "workspace:*",
    "@nublox/workbench-query-engineering": "workspace:*",
    "@nublox/workbench-schema-engineering": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^22.18.6",
    "electron": "44.4.5",
    "monaco-editor": "0.57.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "^5.8.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "com.nublox.sqlworkbench",
    "productName": "NuBlox SQL Workbench",
    "artifactName": "NuBlox-SQL-Workbench-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/renderer/**/*",
      "dist/electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["zip"]
    },
    "linux": {
      "category": "Development",
      "target": ["AppImage"]
    },
    "win": {
      "target": ["portable"]
    }
  }
}
